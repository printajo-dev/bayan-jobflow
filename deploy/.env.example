# Copy to deploy/.env (install.sh does this and fills in the secrets).
# Never commit deploy/.env.

# The server's fixed LAN IP. Users open https://<this address>.
# (To add an internal DNS name later, see docs/install-ubuntu.md.)
JOBFLOW_HOST=192.168.1.50
# Address the HTTPS ports are published on. Use the LAN IP so nothing listens
# on other interfaces.
BIND_IP=192.168.1.50

# Where business data lives on the server.
DATA_ROOT=/srv/company-data

TZ=Asia/Dubai

# Generated by install.sh: long random hex strings.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Optional tuning (defaults shown)
# SESSION_IDLE_MINUTES=720
# SESSION_ABSOLUTE_HOURS=168
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_MINUTES=15
# Largest single upload in MB (enforced by the API)
# UPLOAD_MAX_MB=200

# Backups (deploy/scripts/backup.sh; defaults shown)
# Mount point of the external backup disk + /restic. The disk must contain an
# empty file named .jobflow-backup-disk at its root.
# OFFSITE_REPOSITORY=/media/jobflow-backup/restic
# DB_DUMP_KEEP_DAYS=14
# RESTIC_KEEP=--keep-daily 14 --keep-weekly 8 --keep-monthly 12

# Set by install.sh / update.sh; shown on Administration → System.
# JOBFLOW_RELEASE=
