# Bayan JobFlow reverse proxy (LAN only).
# Users open https://{$JOBFLOW_HOST}. The certificate comes from Caddy's own
# internal certificate authority; install its root certificate on each office
# PC once (deploy/scripts/export-ca.sh). Nothing here contacts the internet.
{
	# Browsers send no SNI when connecting to an IP address.
	default_sni {$JOBFLOW_HOST}
	local_certs
	skip_install_trust
	admin off
}

{$JOBFLOW_HOST} {
	tls internal
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		# Microphone is allowed for this site only (voice notes).
		Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /socket.io/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv/www
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html not path /assets/*
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
