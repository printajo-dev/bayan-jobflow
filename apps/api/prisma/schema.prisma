// Bayan JobFlow — PostgreSQL schema.
// Conventions: UUID v7 keys, snake_case tables/columns, timestamptz.
// History tables (audit_logs) are append-only; see the migration that adds
// the protecting trigger.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum RoleScope {
  GLOBAL
  DEPARTMENT
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD
}

model Department {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique @db.VarChar(20)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  members    UserDepartment[]
  roleScopes RoleDepartmentScope[]

  @@map("departments")
}

model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  username           String     @unique @db.VarChar(50)
  fullName           String     @map("full_name") @db.VarChar(120)
  email              String?    @db.VarChar(200)
  passwordHash       String     @map("password_hash")
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt  DateTime   @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles       UserRole[]       @relation("UserRoles")
  departments UserDepartment[]
  sessions    Session[]
  auditLogs   AuditLog[]

  @@index([status])
  @@map("users")
}

model Role {
  id          String    @id @default(uuid(7)) @db.Uuid
  key         String    @unique @db.VarChar(50)
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  scope       RoleScope
  /// System roles are seeded; they can be edited but not deleted.
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions      RolePermission[]
  users            UserRole[]
  departmentScopes RoleDepartmentScope[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique @db.VarChar(80)
  area        String @db.VarChar(50)
  description String @db.VarChar(300)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation("UserRoles", fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model UserDepartment {
  userId       String   @map("user_id") @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  /// Department leaders assign work and complete stages for their department.
  isLeader     Boolean  @default(false) @map("is_leader")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([userId, departmentId])
  @@index([departmentId])
  @@map("user_departments")
}

/// Limits a DEPARTMENT-scoped role to specific departments. A DEPARTMENT role
/// with no rows here applies to every department the user belongs to.
model RoleDepartmentScope {
  roleId       String @map("role_id") @db.Uuid
  departmentId String @map("department_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([roleId, departmentId])
  @@map("role_department_scopes")
}

model Session {
  /// SHA-256 of the cookie token; the token itself is never stored.
  id         String   @id @db.Char(64)
  userId     String   @map("user_id") @db.Uuid
  csrfToken  String   @map("csrf_token") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  ip         String?  @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(300)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.Uuid
  summary    String   @db.VarChar(500)
  before     Json?
  after      Json?
  ip         String?  @db.VarChar(64)
  requestId  String?  @map("request_id") @db.VarChar(64)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id             String       @id @default(uuid(7)) @db.Uuid
  type           String       @db.VarChar(100)
  aggregateType  String       @map("aggregate_type") @db.VarChar(50)
  aggregateId    String       @map("aggregate_id") @db.Uuid
  payload        Json
  /// Unique per logical event so a retried write cannot enqueue it twice.
  idempotencyKey String       @unique @map("idempotency_key") @db.VarChar(200)
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  nextAttemptAt  DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError      String?      @map("last_error")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt    DateTime?    @map("processed_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@map("workflow_outbox_events")
}

model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}
